\end_inset


\end_layout

\begin_layout Standard
Given 
\begin_inset Formula $X=0$
\end_inset

,
 suppose i choose 
\begin_inset Formula $Y=0$
\end_inset

 with probability 
\begin_inset Formula $a$
\end_inset

,
 and 
\begin_inset Formula $Y=1$
\end_inset

 with probability 
\begin_inset Formula $1-a$
\end_inset

.
 Then the probability that i choose 
\begin_inset Formula $Y=\hat{y}$
\end_inset

 correctly,
 is given by:
 
\begin_inset Formula 
\[
P\left(Y=\hat{y}\mid X=0\right)=a\cdot P\left(Y=0\mid X=0\right)+\left(1-a\right)P\left(Y=1\mid X=0\right).
\]

\end_inset


\end_layout

\begin_layout Standard
The expected 0-1 loss is then given by:
 
\begin_inset Formula 
\begin{align*}
\mathcal{R}_{p}\left(\hat{y}\left(a\right)\right) & =1-P\left(Y=\hat{y}\mid X=0\right),\\
 & =1-\left(a\cdot P\left(Y=0\mid X=0\right)+\left(1-a\right)P\left(Y=1\mid X=0\right)\right).
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
I want to minimize the expected 0-1 loss:
 
\begin_inset Formula 
\[
\min_{a\in\left[0,1\right]}\mathcal{R}_{p}\left(\hat{y}\left(a\right)\right).
\]

\end_inset


\end_layout

\begin_layout Standard
Since 
\begin_inset Formula $\mathcal{R}_{p}\left(\hat{y}\left(a\right)\right)$
\end_inset

 is linear,
 a value of 
\begin_inset Formula $a$
\end_inset

 that minimizes 
\begin_inset Formula $\mathcal{R}_{p}\left(\hat{y}\left(a\right)\right)$
\end_inset

 will always be a boundary case,
 either 
\begin_inset Formula $a^{*}=0$
\end_inset

 or 
\begin_inset Formula $a^{*}=1$
\end_inset

:
 
\begin_inset Formula $\mathcal{R}_{p}\left(\hat{y}\left(a^{*}\right)\right)\leq\mathcal{R}_{p}\left(\hat{y}\left(a\right)\right)$
\end_inset

 for all 
\begin_inset Formula $a\in\left[0,1\right]$
\end_inset

.
 Therefore,
 the deterministic classification from question 1,
 where 
\begin_inset Formula $y=\arg\max_{y\in\{0,1\}}P\left(Y=y\mid X=x\right)$
\end_inset

,
 is a weakly optimal classifier when using the 0-1 loss as a measure for performance.
\end_layout

