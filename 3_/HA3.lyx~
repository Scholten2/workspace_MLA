\begin_layout Subsection
Cross-entropy error measure (16 points)
\end_layout

\begin_layout Subsubsection
Rewriting negative logarithmic likelihood as cross-entropy
\end_layout

\begin_layout Standard
In the case where 
\begin_inset Formula $Y\in\left\{ -1,1\right\} ,$
\end_inset

and 
\begin_inset Formula $h\left(\boldsymbol{x}\right)=P\left(Y=1\mid X=\boldsymbol{x}\right),$
\end_inset

i can write the data generation process:
 
\begin_inset Formula 
\begin{align*}
P\left(Y=y\mid X=\boldsymbol{x}\right) & =\begin{cases}
h(\boldsymbol{x}) & \text{for }y=1\\
1-h\left(\boldsymbol{x}\right) & \text{for }y=-1
\end{cases},\\
 & =\mathbf{1}_{\left\{ y=1\right\} }h(\boldsymbol{x})+\mathbf{1}_{\left\{ y=-1\right\} }\left(1-h(\boldsymbol{x})\right).
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
From above i can derive the negative likelihood function:
 
\begin_inset Formula 
\[
\mathcal{L}\left(\boldsymbol{w}\right)=\frac{1}{N}\prod^{N}_{n=1}\left[-P\left(Y_{n}=y_{n}\mid X_{n}=\boldsymbol{x_{n}};\boldsymbol{w}\right)\right].
\]

\end_inset


\end_layout

\begin_layout Standard
The corresponding negative log-likelihood function is the:
 
\begin_inset Formula 
\[
\log\left(\mathcal{L}\left(\boldsymbol{w}\right)\right)=\frac{1}{N}\sum^{N}_{n=1}\log\left(\frac{1}{P\left(Y_{n}=y_{n}\mid X_{n}=\boldsymbol{x}_{n};\boldsymbol{w}\right)}\right).
\]

\end_inset


\end_layout

\begin_layout Standard
Substituting in 
\begin_inset Formula $P\left(Y=y\mid X=\boldsymbol{x}\right)=\mathbf{1}_{\left\{ y=1\right\} }h(\boldsymbol{x})+\mathbf{1}_{\left\{ y=-1\right\} }\left(1-h(\boldsymbol{x})\right)$
\end_inset

,
 yields:
 
\begin_inset Formula 
\[
\log\left(\mathcal{L}\left(\boldsymbol{w}\right)\right)=\frac{1}{N}\sum^{N}_{n=1}\left[\mathbf{1}_{\left\{ y=1\right\} }\log\left(\frac{1}{h(\boldsymbol{x_{n};\boldsymbol{w}})}\right)+\mathbf{1}_{\left\{ y=-1\right\} }\log\left(\frac{1}{1-h(\boldsymbol{x_{n}};\boldsymbol{w})}\right)\right],
\]

\end_inset

which is what i wanted to show.
 From now on i define:
 
\begin_inset Formula 
\[
\mathcal{L}\left(\boldsymbol{w}\right)=\frac{1}{N}\sum^{N}_{n=1}\left[\mathbf{1}_{\left\{ y=1\right\} }\log\left(\frac{1}{h(\boldsymbol{x_{n};\boldsymbol{w}})}\right)+\mathbf{1}_{\left\{ y=-1\right\} }\log\left(\frac{1}{1-h(\boldsymbol{x_{n}};\boldsymbol{w})}\right)\right].\tag{2}
\]

\end_inset


\end_layout

\begin_layout Subsubsection
Cross-entropy and logistic regression
\end_layout

\begin_layout Standard
To show that:
 
\begin_inset Formula 
\begin{align*}
\mathcal{L}\left(\boldsymbol{w}\right) & =\frac{1}{N}\sum^{N}_{n=1}\left[\mathbf{1}_{\left\{ y=1\right\} }\log\left(\frac{1}{h(\boldsymbol{x_{n};\boldsymbol{w}})}\right)+\mathbf{1}_{\left\{ y=-1\right\} }\log\left(\frac{1}{1-h(\boldsymbol{x_{n}};\boldsymbol{w})}\right)\right],\tag{2}\\
 & =\frac{1}{N}\sum^{N}_{n=1}\log\left(1+e^{-y_{n}\boldsymbol{w}^{\mathrm{T}}\boldsymbol{x}_{n}}\right),\tag{1}
\end{align*}

\end_inset

i use,
 that the sigmoid function has the following property:
 
\begin_inset Formula 
\begin{align*}
P\left(Y=y\mid X=\boldsymbol{x};\boldsymbol{w}\right) & =\theta\left(y\boldsymbol{w}^{T}\boldsymbol{x}\right),\\
 & =\begin{cases}
\theta\left(\boldsymbol{w}^{T}\boldsymbol{x}\right) & \text{for }y=1\\
1-\theta\left(\boldsymbol{w}^{T}\boldsymbol{x}\right) & \text{for }y=-1
\end{cases},
\end{align*}

\end_inset

where 
\begin_inset Formula 
\[
\theta\left(z\right)=\frac{1}{1+e^{-z}}.
\]

\end_inset


\end_layout

\begin_layout Standard
This means that:
 
\begin_inset Formula 
\begin{align*}
-\log\left(\theta\left(z\right)\right) & =\log\left(1+e^{-z}\right),\\
\Rightarrow-\log\left(\theta\left(y\boldsymbol{w}^{T}\boldsymbol{x}\right)\right) & =\log\left(1+e^{-y\boldsymbol{w}^{T}\boldsymbol{x}}\right).
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
Plugging the above expression into equation (1) from the assignment,
 and using that 
\begin_inset Formula $P\left(Y=y\mid X=\boldsymbol{x};\boldsymbol{w}\right)=\theta\left(y\boldsymbol{w}^{T}\boldsymbol{x}\right)$
\end_inset

,
 yields:
 
\begin_inset Formula 
\begin{align*}
\mathcal{L}\left(\boldsymbol{w}\right) & =\frac{1}{N}\sum^{N}_{n=1}-\log\left(\theta\left(y_{n}\boldsymbol{w}^{T}\boldsymbol{x}_{n}\right)\right),\\
 & =\frac{1}{N}\sum^{N}_{n=1}-\log\left(P\left(Y=y_{n}\mid X=\boldsymbol{x}_{n};\boldsymbol{w}\right)\right),\\
 & =\frac{1}{N}\sum^{N}_{n=1}\left[\mathbf{1}_{\left\{ y=1\right\} }\log\left(\frac{1}{h(\boldsymbol{x_{n};\boldsymbol{w}})}\right)+\mathbf{1}_{\left\{ y=-1\right\} }\log\left(\frac{1}{1-h(\boldsymbol{x_{n}};\boldsymbol{w})}\right)\right],
\end{align*}

\end_inset

which is what i wanted to show.
\end_layout

\begin_layout Subsection
Logistic regression loss gradient (24 points)
\end_layout

\begin_layout Subsubsection
Gradient for 
\begin_inset Formula $-1$
\end_inset

 and 
\begin_inset Formula $1$
\end_inset


\end_layout

\begin_layout Standard
Consider the negative log-likelihood function (eq.
 (1)):
 
\begin_inset Formula 
\[
\mathcal{L}\left(\boldsymbol{w}\right)=\frac{1}{N}\sum^{N}_{n=1}\log\left(1+e^{-y_{n}\boldsymbol{w}^{\mathrm{T}}\boldsymbol{x}_{n}}\right).
\]

\end_inset


\end_layout

\begin_layout Standard
Using the chain rule,
 the gradient of the negative log-likelihood can be derived:
 
\begin_inset Formula 
\begin{align*}
\nabla\mathcal{L}\left(\boldsymbol{w}\right) & =\frac{\partial\mathcal{L}(\mathbf{w})}{\partial\boldsymbol{w}}\\
 & =\frac{1}{N}\sum^{N}_{n=1}\left(\begin{array}{c}
\frac{\partial}{\partial w_{1}}\log\left(1+e^{-y_{n}\boldsymbol{w}^{\mathrm{T}}x_{n}}\right)\\
\frac{\partial}{\partial w_{2}}\log\left(1+e^{-y_{n}\boldsymbol{w}^{\mathrm{T}}x_{n}}\right)\\
\vdots\\
\frac{\partial}{\partial w_{d}}\log\left(1+e^{-y_{n}\boldsymbol{w}^{\mathrm{T}}x_{n}}\right)
\end{array}\right),\\
 & =\frac{1}{N}\sum^{N}_{n=1}\left(\begin{array}{c}
-y_{n}x_{n1}\frac{e^{-y_{n}\boldsymbol{w}^{\mathrm{T}}x_{n1}}}{1+e^{-y_{n}\boldsymbol{w}^{\mathrm{T}}x_{n1}}}\\
-y_{n}x_{n2}\frac{e^{-y_{n}\boldsymbol{w}^{\mathrm{T}}x_{n2}}}{1+e^{-y_{n}\boldsymbol{w}^{\mathrm{T}}x_{n2}}}\\
\vdots\\
-y_{n}x_{n2}\frac{e^{-y_{n}\boldsymbol{w}^{\mathrm{T}}x_{nd}}}{1+e^{-y_{n}\boldsymbol{w}^{\mathrm{T}}x_{nd}}}
\end{array}\right),\\
 & =\frac{1}{N}\sum^{N}_{n=1}-y_{n}\boldsymbol{x}_{n}\frac{e^{-y_{n}\boldsymbol{w}^{\mathrm{T}}\boldsymbol{x}_{n}}}{1+e^{-y_{n}\boldsymbol{w}^{\mathrm{T}}\boldsymbol{x}_{n}}},\\
 & =\frac{1}{N}\sum^{N}_{n=1}-y_{n}\boldsymbol{x}_{n}\frac{e^{-y_{n}\boldsymbol{w}^{\mathrm{T}}\boldsymbol{x}_{n}}e^{y_{n}\boldsymbol{w}^{\mathrm{T}}\boldsymbol{x}_{n}}}{\left(1+e^{-y_{n}\boldsymbol{w}^{\mathrm{T}}\boldsymbol{x}_{n}}\right)e^{1y\boldsymbol{w}^{\mathrm{T}}\boldsymbol{x}_{n}}},\\
 & =\frac{1}{N}\sum^{N}_{n=1}-y_{n}\boldsymbol{x}_{n}\frac{1}{1+e^{y_{n}\boldsymbol{w}^{\mathrm{T}}\boldsymbol{x}_{n}}},\\
 & =\frac{1}{N}\sum^{N}_{n=1}-y_{n}\boldsymbol{x}_{n}\theta\left(-y_{n}\boldsymbol{w}^{\mathrm{T}}\boldsymbol{x}_{n}\right).
\end{align*}

\end_inset


\end_layout

\begin_layout Subsubsection
Gradient for 
\begin_inset Formula $0$
\end_inset

 and 
\begin_inset Formula $1$
\end_inset


\end_layout

\begin_layout Standard
When 
\begin_inset Formula $Y\in\left\{ 0,1\right\} ,P\left(Y=y\mid X=\boldsymbol{x};\boldsymbol{w}\right)$
\end_inset

 can be written:
 
\begin_inset Formula 
\begin{align*}
P\left(Y=y\mid X=\boldsymbol{x};\boldsymbol{w}\right) & =\theta\left(\boldsymbol{w}^{T}\boldsymbol{x}\right)^{y}\left(1-\theta\left(\boldsymbol{w}^{T}\boldsymbol{x}\right)\right)^{1-y},\\
 & =\begin{cases}
\theta\left(\boldsymbol{w}^{T}\boldsymbol{x}\right) & \text{for }y=1\\
1-\theta\left(\boldsymbol{w}^{T}\boldsymbol{x}\right) & \text{for }y=0
\end{cases}.
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
Using the above expression,
 the negative log-likelihood function can be written:
 
\begin_inset Formula 
\begin{align*}
\mathcal{L}\left(\boldsymbol{w}\right) & =-\frac{1}{N}\sum^{N}_{n=1}\log\left(P\left(Y=y_{n}\mid X=\boldsymbol{x_{n}};\boldsymbol{w}\right)\right),\\
 & =-\frac{1}{N}\sum^{N}_{n=1}\log\left(\theta\left(\boldsymbol{w}^{T}\boldsymbol{x}_{n}\right)^{y_{n}}\left(1-\theta\left(\boldsymbol{w}^{T}\boldsymbol{x}_{n}\right)\right)^{1-y_{n}}\right),\\
 & =-\frac{1}{N}\sum^{N}_{n=1}y_{n}\log\left(\theta\left(\boldsymbol{w}^{T}\boldsymbol{x}_{n}\right)\right)+\left(1-y_{n}\right)\log\left(1-\theta\left(\boldsymbol{w}^{T}\boldsymbol{x}_{n}\right)\right),\\
 & =-\frac{1}{N}\sum^{N}_{n=1}\left(y_{n}\log\left(\frac{1}{1+e^{-\boldsymbol{w}^{T}\boldsymbol{x}_{n}}}\right)+\left(1-y_{n}\right)\log\left(1-\frac{1}{1+e^{-\boldsymbol{w}^{T}\boldsymbol{x}_{n}}}\right)\right),\\
 & =-\frac{1}{N}\sum^{N}_{n=1}\left(-y_{n}\log\left(1+e^{-\boldsymbol{w}^{T}\boldsymbol{x}_{n}}\right)+\left(1-y_{n}\right)\log\left(\frac{e^{-\boldsymbol{w}^{T}\boldsymbol{x}_{n}}}{1+e^{-\boldsymbol{w}^{T}\boldsymbol{x}_{n}}}\right)\right),\\
 & =-\frac{1}{N}\sum^{N}_{n=1}\left(-y_{n}\log\left(1+e^{-\boldsymbol{w}^{T}\boldsymbol{x}_{n}}\right)+\left(1-y_{n}\right)\log\left(\frac{1}{1+e^{\boldsymbol{w}^{T}\boldsymbol{x}_{n}}}\right)\right)\\
 & =-\frac{1}{N}\sum^{N}_{n=1}\left(-y_{n}\log\left(1+e^{-\boldsymbol{w}^{T}\boldsymbol{x}_{n}}\right)-\left(1-y_{n}\right)\log\left(1+e^{\boldsymbol{w}^{T}\boldsymbol{x}_{n}}\right)\right),\\
 & =\frac{1}{N}\sum^{N}_{n=1}\left(y_{n}\log\left(1+e^{-\boldsymbol{w}^{T}\boldsymbol{x}_{n}}\right)+\left(1-y_{n}\right)\log\left(1+e^{\boldsymbol{w}^{T}\boldsymbol{x}_{n}}\right)\right).
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
The gradient can then be derived:
 
\begin_inset Formula 
\begin{align*}
\nabla\mathcal{L}\left(\boldsymbol{w}\right) & =\frac{\partial\mathcal{L}(\mathbf{w})}{\partial\boldsymbol{w}}\\
 & =\frac{1}{N}\sum^{N}_{n=1}\left(\begin{array}{c}
\frac{\partial}{\partial w_{1}}\left(y_{n}\log\left(1+e^{-\boldsymbol{w}^{T}x_{n}}\right)+\left(1-y_{n}\right)\log\left(1+e^{\boldsymbol{w}^{T}x_{n}}\right)\right)\\
\frac{\partial}{\partial w_{2}}\left(y_{n}\log\left(1+e^{-\boldsymbol{w}^{T}x_{n}}\right)+\left(1-y_{n}\right)\log\left(1+e^{\boldsymbol{w}^{T}x_{n}}\right)\right)\\
\vdots\\
\frac{\partial}{\partial w_{d}}\left(y_{n}\log\left(1+e^{-\boldsymbol{w}^{T}x_{n}}\right)+\left(1-y_{n}\right)\log\left(1+e^{\boldsymbol{w}^{T}x_{n}}\right)\right)
\end{array}\right),\\
 & =\frac{1}{N}\sum^{N}_{n=1}\left(\begin{array}{c}
\nabla l_{1}\\
\nabla l_{2}\\
\vdots\\
\nabla l_{d}
\end{array}\right)
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
For the sake of simplicity,
 i will derive 
\begin_inset Formula $\nabla l_{i}$
\end_inset

,
 and then generalize to 
\begin_inset Formula $\nabla\mathcal{L}\left(\boldsymbol{w}\right)=\frac{1}{N}\sum^{N}_{n=1}\nabla\boldsymbol{l}$
\end_inset

:
 
\begin_inset Formula 
\begin{align*}
\nabla l_{i} & =\frac{\partial}{\partial w_{i}}\left(y_{n}\log\left(1+e^{-\boldsymbol{w}^{T}x_{ni}}\right)+\left(1-y_{n}\right)\log\left(1+e^{\boldsymbol{w}^{T}x_{ni}}\right)\right),\\
 & =-x_{ni}y_{n}\frac{e^{-\boldsymbol{w}^{T}x_{ni}}}{1+e^{-\boldsymbol{w}^{T}x_{ni}}}+x_{ni}\left(1-y_{n}\right)\frac{e^{\boldsymbol{w}^{T}x_{ni}}}{1+e^{\boldsymbol{w}^{T}x_{ni}}},\\
 & =-x_{ni}y_{n}\left(1-\frac{1}{1+e^{\boldsymbol{-w}^{T}x_{ni}}}\right)+x_{ni}\left(1-y_{n}\right)\frac{1}{1+e^{\boldsymbol{-w}^{T}x_{ni}}},\\
 & =-x_{ni}\left(y_{n}-y_{n}\frac{1}{1+e^{\boldsymbol{-w}^{T}x_{ni}}}-\frac{1}{1+e^{\boldsymbol{-w}^{T}x_{ni}}}+y_{n}\frac{1}{1+e^{\boldsymbol{-w}^{T}x_{ni}}}\right),\\
 & =-x_{ni}\left(y_{n}-\frac{1}{1+e^{\boldsymbol{-w}^{T}x_{ni}}}\right).
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
Plugging the above expression into 
\begin_inset Formula $\nabla\mathcal{L}\left(\boldsymbol{w}\right)$
\end_inset

,
 yields:
 
\begin_inset Formula 
\begin{align*}
\nabla\mathcal{L}\left(\boldsymbol{w}\right) & =\frac{1}{N}\sum^{N}_{n=1}\left(\begin{array}{c}
-x_{n1}\left(y_{n}-\frac{1}{1+e^{\boldsymbol{-w}^{T}x_{n1}}}\right)\\
-x_{n2}\left(y_{n}-\frac{1}{1+e^{\boldsymbol{-w}^{T}x_{n2}}}\right)\\
\vdots\\
-x_{nd}\left(y_{n}-\frac{1}{1+e^{\boldsymbol{-w}^{T}x_{nd}}}\right)
\end{array}\right),\\
 & =-\frac{1}{N}\sum^{N}_{n=1}\left(\begin{array}{c}
\left(y_{n}-\theta\left(\boldsymbol{w}^{T}x_{n1}\right)\right)x_{n1}\\
\left(y_{n}-\theta\left(\boldsymbol{w}^{T}x_{n2}\right)\right)x_{n2}\\
\vdots\\
\left(y_{n}-\theta\left(\boldsymbol{w}^{T}x_{nd}\right)\right)x_{nd}
\end{array}\right),\\
 & =-\frac{1}{N}\sum^{N}_{n=1}\left(y_{n}-\theta\left(\boldsymbol{w}^{T}\boldsymbol{x}_{n}\right)\right)\boldsymbol{x}_{n}.
\end{align*}

\end_inset


\end_layout

\begin_layout Subsubsection
Influence of misclassified examples
\end_layout

\begin_layout Standard

\series bold
For 
\begin_inset Formula $\boldsymbol{Y\in\left\{ 0,1\right\} }$
\end_inset


\series default
,
 the gradient contribution of one observation is given by:
\begin_inset Formula 
\[
\nabla l_{n=i}=-\frac{1}{N}\left(y_{i}-\theta\left(\boldsymbol{w}^{T}\boldsymbol{x}_{i}\right)\right)\boldsymbol{x}_{i}.
\]

\end_inset


\end_layout

\begin_layout Standard
I start by defining 
\begin_inset Formula $m_{i}=y_{i}-\theta\left(\boldsymbol{w}^{T}\boldsymbol{x}_{i}\right)$
\end_inset

.
\end_layout

\begin_layout Standard
The sample can be misclassified in two ways:
 If the model predicts 
\begin_inset Formula $\hat{y}_{i}=0$
\end_inset

,
 when 
\begin_inset Formula $y_{i}=1$
\end_inset

,
 then 
\begin_inset Formula $\theta\left(\boldsymbol{w}^{T}\boldsymbol{x}_{i}\right)<0.5,$
\end_inset

which yields:
\begin_inset Formula 
\[
m_{i}=1-\theta\left(\boldsymbol{w}^{T}\boldsymbol{x}_{i}\right)>0.5.
\]

\end_inset

If the model predicts 
\begin_inset Formula $\hat{y}_{i}=1$
\end_inset

,
 when 
\begin_inset Formula $y_{i}=0$
\end_inset

,
 then 
\begin_inset Formula $\theta\left(\boldsymbol{w}^{T}\boldsymbol{x}_{i}\right)>0.5$
\end_inset

,
 which yields:
\begin_inset Formula 
\[
m_{i}=0-\theta\left(\boldsymbol{w}^{T}\boldsymbol{x}_{i}\right)<-0.5.
\]

\end_inset


\end_layout

\begin_layout Standard
Thus,
 the gradient contribution when a sample is misclassified is:
\begin_inset Formula 
\[
\lvert m^{mis}_{i}\rvert=\lvert y_{i}-\theta\left(\boldsymbol{w}^{T}\boldsymbol{x}_{i}\right)\rvert>0.5.
\]

\end_inset


\end_layout

\begin_layout Standard
When the sample is correctly classified (ie.
 
\begin_inset Formula $\hat{y}_{i}=y_{i})$
\end_inset

 then:
\begin_inset Formula 
\[
\lvert m^{cor}_{i}\rvert=\lvert y_{i}-\theta\left(\boldsymbol{w}^{T}\boldsymbol{x}_{i}\right)\rvert<0.5,
\]

\end_inset

since 
\begin_inset Formula $\theta\left(\boldsymbol{w}^{T}\boldsymbol{x}_{i}\right)>0.5,$
\end_inset

when 
\begin_inset Formula $y_{i}=1$
\end_inset

,
 and 
\begin_inset Formula $\theta\left(\boldsymbol{w}^{T}\boldsymbol{x}_{i}\right)<0.5,$
\end_inset

when 
\begin_inset Formula $y_{i}=0$
\end_inset

.
\end_layout

\begin_layout Standard
This means,
 that the gradient contribution of a misclassified sample is always bigger than a correctly classified sample (for a given sample):
\begin_inset Formula 
\[
\lvert\nabla l^{mis}_{n=i}\rvert=\lvert-\frac{1}{N}\left(m^{mis}_{i}\right)\boldsymbol{x}_{i}\rvert>\lvert\nabla l^{cor}_{n=i}\rvert=\lvert-\frac{1}{N}\left(m^{cor}_{i}\right)\boldsymbol{x}_{i}\rvert.
\]

\end_inset


\end_layout

\begin_layout Standard

\series bold
For 
\begin_inset Formula $\boldsymbol{Y\in\left\{ -1,1\right\} }$
\end_inset


\series default
,
 the gradient contribution of one observation is given by:
\begin_inset Formula 
\[
\nabla l_{n=i}=-\frac{1}{N}y_{i}\boldsymbol{x}_{i}\theta\left(-y_{i}\boldsymbol{w}^{\mathrm{T}}\boldsymbol{x}_{i}\right).
\]

\end_inset


\end_layout

\begin_layout Standard
I first define 
\begin_inset Formula $m_{i}=-y_{i}\boldsymbol{w}^{\mathrm{T}}\boldsymbol{x}_{i}$
\end_inset

.
\end_layout

\begin_layout Standard
If the model predicts 
\begin_inset Formula $\hat{y}_{i}=1$
\end_inset

,
 when 
\begin_inset Formula $y_{i}=-1$
\end_inset

,
 then:
\begin_inset Formula 
\[
\boldsymbol{w}^{\mathrm{T}}\boldsymbol{x}_{i}>0\Rightarrow m_{i}>0.
\]

\end_inset


\end_layout

\begin_layout Standard
If the model predicts 
\begin_inset Formula $\hat{y}_{i}=-1$
\end_inset

,
 when 
\begin_inset Formula $y_{i}=1$
\end_inset

,
 then:
\begin_inset Formula 
\[
\boldsymbol{w}^{\mathrm{T}}\boldsymbol{x}_{i}<0\Rightarrow m_{i}>0.
\]

\end_inset


\end_layout

\begin_layout Standard
Thus:
\begin_inset Formula 
\[
m^{mis}_{i}>0.
\]

\end_inset


\end_layout

\begin_layout Standard
If the model classifies 
\begin_inset Formula $\hat{y}_{i}=y_{i}$
\end_inset

 correctly,
 then 
\begin_inset Formula $m_{i}$
\end_inset

 becomes negative:
\begin_inset Formula 
\[
m^{cor}_{i}<0.
\]

\end_inset


\end_layout

\begin_layout Standard
Since the sigmpid 
\begin_inset Formula $\theta\left(m_{i}\right)$
\end_inset

 is increasing in 
\begin_inset Formula $m_{i}$
\end_inset

,
 the gradient contribution of a given misclasiffied sample will always be bigger than the correctly classified sample:
\begin_inset Formula 
\begin{align*}
m^{cor}_{i} & <m^{mis}_{i}\Rightarrow\theta\left(m^{cor}_{i}\right)<\theta\left(m^{mis}_{i}\right),\\
\Rightarrow\lvert\nabla l^{cor}_{n=i}\rvert & =\lvert-\frac{1}{N}y_{i}\boldsymbol{x}_{i}\theta\left(m^{cor}_{i}\right)\rvert<\lvert\nabla l^{mis}_{n=i}\rvert=\lvert-\frac{1}{N}y_{i}\boldsymbol{x}_{i}\theta\left(m^{cor}_{i}\right)
\end{align*}

\end_inset


\end_layout

\begin_layout Subsection
Log-odds (10 points)
\end_layout

\begin_layout Standard
To show that:
\begin_inset Formula 
\[
f(\mathbf{x})=\sigma(\boldsymbol{w}^{\mathrm{T}}\boldsymbol{x}+b)=P(Y=1\mid X=\boldsymbol{x}),
\]

\end_inset

where 
\begin_inset Formula $\sigma\left(\cdot\right)$
\end_inset

is the logistic function 
\begin_inset Formula $\sigma\left(\boldsymbol{w}^{\mathrm{T}}\boldsymbol{x}+b\right)=\frac{1}{1+e^{-\left(\boldsymbol{w}^{\mathrm{T}}\boldsymbol{x}+b\right)}}$
\end_inset

,
 i start by rewriting eq.
 (4) from the assignment:
\begin_inset Formula 
\begin{align*}
\boldsymbol{w}^{\mathrm{T}}\boldsymbol{x}+b & =\log\left(\frac{P(Y=1\mid X=x)}{P(Y=0\mid X=x)}\right),\\
 & =-\log\left(\frac{P\left(Y=0\mid X=x\right)}{P\left(Y=1\mid X=x\right)}\right),\\
\Leftrightarrow-\left(\boldsymbol{w}^{\mathrm{T}}\boldsymbol{x}+b\right) & =\log\left(\frac{P\left(Y=0\mid X=x\right)}{P\left(Y=1\mid X=x\right)}\right),\\
\Leftrightarrow e^{-\left(\boldsymbol{w}^{\mathrm{T}}\boldsymbol{x}+b\right)} & =\frac{P\left(Y=0\mid X=x\right)}{P\left(Y=1\mid X=x\right)},\\
 & =\frac{1-P\left(Y=1\mid X=x\right)}{P\left(Y=1\mid X=x\right)},\\
 & =\frac{1}{P\left(Y=1\mid X=x\right)}-1,\\
\Leftrightarrow1+e^{-\left(\boldsymbol{w}^{\mathrm{T}}\boldsymbol{x}+b\right)} & =\frac{1}{P\left(Y=1\mid X=x\right)},\\
\Leftrightarrow P\left(Y=1\mid X=x\right) & =\frac{1}{1+e^{-\left(\boldsymbol{w}^{\mathrm{T}}\boldsymbol{x}+b\right)}}.
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
Comparing the expression above to eq.
 (3) from the assignment,
 it is obvious that 
\begin_inset Formula $\sigma\left(\cdot\right)$
\end_inset

 is the logistic function 
\begin_inset Formula $\sigma\left(z\right)=\frac{1}{1+e^{-z}}$
\end_inset

:
\begin_inset Formula 
\[
f(\mathbf{x})=\sigma(\boldsymbol{w}^{\mathrm{T}}\boldsymbol{x}+b)=P(Y=1\mid X=\boldsymbol{x})=\frac{1}{1+e^{-\left(\boldsymbol{w}^{\mathrm{T}}\boldsymbol{x}+b\right)}}.
\]

\end_inset


\end_layout

